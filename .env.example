# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  WHATSAPP - NOTIFICACIONES DE CURSOS                                   ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#  MODO SIMULACIÓN (por defecto, sin costo):
#    - No envía mensajes reales
#    - Solo registra en consola y en logs/whatsapp.log
#    - No requiere ninguna variable adicional
#
#  MODO REAL (Meta Cloud API):
#    - Cambia WHATSAPP_MODE a "real"
#    - Completa WHATSAPP_TOKEN, WHATSAPP_PHONE_ID y WHATSAPP_FROM
#    - Requiere: pip install requests

WHATSAPP_MODE=simulacion
# WHATSAPP_MODE=real          # ← Descomenta cuando tengas presupuesto aprobado
# WHATSAPP_TOKEN=EAAT...      # Token permanente de System User en Meta
# WHATSAPP_PHONE_ID=123456... # ID del número en Meta Business
# WHATSAPP_FROM=573001234567  # Tu número corporativo (código país + número, sin +)


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  ENTORNO                                                                ║
# ╚══════════════════════════════════════════════════════════════════════════╝

FLASK_ENV=development
# FLASK_ENV=production    # ← Cambia en producción (activa cookies seguras)


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  WEBHOOK WHATSAPP (para ver estado de entrega de mensajes)             ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#  Token que Meta usará para verificar el webhook.
#  Debe coincidir exactamente con el que configures en:
#  developers.facebook.com → App → WhatsApp → Configuración → Webhook

WHATSAPP_WEBHOOK_TOKEN=cambia_esto_por_un_token_secreto
