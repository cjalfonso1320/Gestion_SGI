<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <remove name="FlaskApp" />
                <add name="FlaskApp" path="*" verb="*" modules="FastCgiModule"
                    scriptProcessor="E:\App_Mensajeria\env\Scripts\python.exe|E:\App_Mensajeria\env\Lib\site-packages\wfastcgi.py"
                    resourceType="Unspecified" requireAccess="Script" />
        </handlers>

        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="524288000" />
            </requestFiltering>
        </security>
        <httpErrors errorMode="Detailed" />
    </system.webServer>

    <appSettings>
        <add key="WSGI_HANDLER" value="app.app" />
        <add key="PYTHONPATH" value="E:\App_SGI" />
        <add key="FLASK_ENV" value="production" />
    </appSettings>

    <!--
    ============================================================
    CONFIGURACIÓN SMTP PARA CORREOS DE NOTIFICACIÓN
    ============================================================
    IMPORTANTE: Las siguientes variables de entorno DEBEN estar
    configuradas en el servidor para que funcionen los correos.

    Opción 1 (Recomendada): Configurar como variables de entorno
    del sistema Windows (Panel de Control > Sistema >
    Configuración avanzada > Variables de entorno).
    
    Las variables requeridas son:
        SMTP_SERVER   = webmail.digicomsys.com.co
        SMTP_PORT     = 465
        SMTP_USERNAME = systemcenter@digicomsys.com.co
        SMTP_PASSWORD = **SERVICE0101@

    Opción 2: Crear archivo .env en E:\App_SGI\.env
    con el mismo contenido que el .env de desarrollo.
    Asegúrate de que el usuario del Pool de Aplicaciones
    (IIS AppPool\DefaultAppPool) tenga permisos de lectura.

    Después de cambiar las variables, recicla el Pool de
    Aplicaciones desde el Administrador de IIS.
    ============================================================
    -->
</configuration>
