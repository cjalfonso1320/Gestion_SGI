<configuration>
  <system.webServer>
    <handlers>
      <add name="Python FastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="E:\App_SGI\env\Scripts\python.exe|E:\App_SGI\env\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified" />
    </handlers>

    <appSettings>
      <add key="WSGI_HANDLER" value="app.app" />
      <add key="PYTHONPATH" value="E:\App_SGI" />
    </appSettings>
  </system.webServer>
</configuration>