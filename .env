# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  CORREO ELECTRÓNICO (notificaciones de cursos)                         ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#  Si se dejan vacíos, el sistema omite el envío de correos.
#  Puerto común: 587 (STARTTLS) o 465 (SSL directo).

SMTP_SERVER=webmail.digicomsys.com.co
SMTP_PORT=465
SMTP_USERNAME=systemcenter@digicomsys.com.co
SMTP_PASSWORD=**SERVICE0101@


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  WHATSAPP - NOTIFICACIONES DE CURSOS                                   ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#  MODO SIMULACIÓN (por defecto, sin costo):
#    - No envía mensajes reales
#    - Solo registra en consola y en logs/whatsapp.log
#    - No requiere ninguna variable adicional
#
#  MODO REAL (Meta Cloud API):
#    - Cambia WHATSAPP_MODE a "real"
#    - Completa WHATSAPP_TOKEN, WHATSAPP_PHONE_ID y WHATSAPP_FROM
#    - Requiere: pip install requests

WHATSAPP_MODE=simulacion
# WHATSAPP_MODE=real          # ← Descomenta cuando tengas presupuesto aprobado
# WHATSAPP_TOKEN=EAAN0GjxwZA7IBRhXExm6rpjqGqpoHUOppKzkJMJXH1MQoCZCKlVI7AIXylV8o4olMxN7V6XhmGP8A0x6GM0daulVakthvNtCaZBrxPAaaIYSVCadjZBtpSCjKtCERFDPDIPwjECIn5MXg0sCAWsSh2zTyqVMOy6AKOLPjY1rqiPCZADlTBsFs51uQAFpE0cIZBrgZDZD      # Token permanente de System User en Meta
# WHATSAPP_PHONE_ID=1205448845974843 # ID del número en Meta Business
# WHATSAPP_FROM=573002450551  # Tu número corporativo (código país + número, sin +)


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  ENTORNO                                                                ║
# ╚══════════════════════════════════════════════════════════════════════════╝

FLASK_ENV=production
# FLASK_ENV=production    # ← Cambia en producción (activa cookies seguras)


